 SG_ Engine_Temp : 16|8@1- (1,0) [-128|127] "degC" DBG

BO_ 512 Vehicle_Speed_Info: 8 Controller_dsPIC
 SG_ Vehicle_Speed : 0|16@1+ (0.01,0) [0|655.35] "km/h" DBG

CM_ BU_ Controller_dsPIC "dsPIC33EV256GM106 Main Controller";
